# ==============================
# SofInventory — Variables de Entorno
# ==============================
# Copia este archivo como .env para desarrollo local
# cp backend/.env.example backend/.env

# Django
SECRET_KEY=genera-una-clave-unica-aqui
DEBUG=True

# Base de datos (modo manual, sin DATABASE_URL)
DB_NAME=db_sofinventory
DB_USER=postgres
DB_PASSWORD=alejo123
DB_HOST=localhost
DB_PORT=5432

# ──────────────────────────────────────────────
# Para Railway (producción):
# No uses este archivo. Railway inyecta automáticamente:
#   - DATABASE_URL (cuando agregas PostgreSQL add-on)
#   - PORT (puerto asignado automáticamente)
#   - SECRET_KEY   → configúrala en Railway Dashboard > Variables
#   - DEBUG=False
#   - ALLOWED_HOSTS=.railway.app
#   - CORS_ALLOWED_ORIGINS=https://frontend-xxxx.railway.app
#   - BACKEND_URL=https://backend-xxxx.railway.app (para el frontend)
# ──────────────────────────────────────────────
