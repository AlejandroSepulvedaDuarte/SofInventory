{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "projects": {
    "sofinventory": {
      "services": {
        "backend": {
          "path": "backend",
          "build": {
            "builder": "DOCKERFILE",
            "dockerfilePath": "Dockerfile"
          },
          "deploy": {
            "numReplicas": 1,
            "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 4 --timeout 120 --access-logfile -"
          }
        },
        "frontend": {
          "path": "frontend",
          "build": {
            "builder": "DOCKERFILE",
            "dockerfilePath": "Dockerfile"
          },
          "deploy": {
            "numReplicas": 1
          }
        }
      }
    }
  }
}
