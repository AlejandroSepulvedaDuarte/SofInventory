# ========================================
# SofInventory - Variables de entorno (ejemplo)
# 1. Copie este archivo como `.env` en la raíz del proyecto.
# 2. Genere valores seguros para cada secreto (ver más abajo).
# 3. NUNCA suba el archivo `.env` real a git.
#
# Comando para generar secretos (PowerShell):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ========================================

# --- PostgreSQL ---
POSTGRES_DB=db_backend_sofinventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=genera-una-contrasena-fuerte
DB_PORT=5432

# --- Django ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=genera-una-clave-secreta-aleatoria
# False en producción. True solo en desarrollo local.
DEBUG=False
# Hosts permitidos, separados por coma (ej: dominio.com,localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes CORS permitidos (separados por coma), solo si DEBUG=False.
CSRF_TRUSTED_ORIGINS=

# --- Usuario administrador inicial ---
# Se crea automáticamente la primera vez con `python manage.py seed_data`
# (o al iniciar docker compose). Si INITIAL_ADMIN_PASSWORD está vacío,
# seed_data genera una contraseña aleatoria segura y la imprime una sola vez.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=cambia-esta-contrasena
INITIAL_ADMIN_EMAIL=admin@sofinventory.com
INITIAL_ADMIN_NOMBRE_COMPLETO=Administrador del Sistema
INITIAL_ADMIN_TIPO_DOCUMENTO=CC
INITIAL_ADMIN_NUMERO_DOCUMENTO=1234567890
